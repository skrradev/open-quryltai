#!/usr/bin/env python3

# {{ ansible_managed }}
#
# Sets the Hetzner Cloud firewall (edge, in front of the server) to allow:
#   - TCP 443 only from Cloudflare's published IP ranges (v4 + v6)
#   - UDP 41641 from anywhere  (Tailscale direct connections)
#   - ICMP  (ping / diagnostics)
# set_rules replaces the whole inbound ruleset, so every allowed rule must be
# listed here. Outbound is left unrestricted (no outbound rules => all allowed).
# SSH is not exposed publicly (tailnet-only), so no port 22 rule.

import json
import sys

import requests

HETZNER_API_TOKEN = "{{ hetzner_api_token }}"
HETZNER_FIREWALL_ID = "{{ hetzner_firewall_id }}"

ANYWHERE = ["0.0.0.0/0", "::/0"]


def get_cloudflare_ips(version):
    url = "https://www.cloudflare.com/ips-v" + version
    print("Getting IPs from " + url)
    try:
        response = requests.get(url, timeout=30)
        response.raise_for_status()
        return response.text.strip().split("\n")
    except Exception as e:
        print(f"Failed to retrieve Cloudflare IP ranges: {e}")
        sys.exit(1)


def set_rules(cloudflare_ips):
    headers = {
        "Authorization": f"Bearer {HETZNER_API_TOKEN}",
        "Content-Type": "application/json",
    }
    payload = {
        "rules": [
            {
                "direction": "in",
                "protocol": "tcp",
                "port": "443",
                "source_ips": cloudflare_ips,
                "description": "Cloudflare -> HTTPS origin",
            },
            {
                "direction": "in",
                "protocol": "udp",
                "port": "41641",
                "source_ips": ANYWHERE,
                "description": "Tailscale direct (WireGuard)",
            },
            {
                "direction": "in",
                "protocol": "icmp",
                "source_ips": ANYWHERE,
                "description": "ICMP (ping/diagnostics)",
            },
        ]
    }
    try:
        response = requests.post(
            f"https://api.hetzner.cloud/v1/firewalls/{HETZNER_FIREWALL_ID}/actions/set_rules",
            headers=headers,
            data=json.dumps(payload),
            timeout=30,
        )
        response.raise_for_status()
        print("IPs whitelisted successfully in Hetzner Firewall")
    except Exception as e:
        print(f"Failed to set Hetzner firewall rules: {e}")
        try:
            print(f"Response: {response.json()}")
        except Exception:
            pass
        sys.exit(1)


if __name__ == "__main__":
    ips = get_cloudflare_ips("4") + get_cloudflare_ips("6")
    print("Allowing 443 from these Cloudflare ranges:")
    for ip in ips:
        print(ip)
    set_rules(ips)
