# Environment for {{ java_service_name }}
# {{ ansible_managed }}
PORT={{ backend_port }}
JAVA_OPTS={{ java_opts }}

# Datasource (PostgreSQL is local-only on this host)
DATABASE_URL=jdbc:postgresql://localhost:5432/{{ pg_app_db_name }}
DATABASE_USERNAME={{ pg_app_user }}
DATABASE_PASSWORD={{ lookup('env', 'PG_APP_USER_PASSWORD') }}
