# Environment for server-bootstrap.yml — copy to .env and fill in.
# Load before running:  set -a && source .env && set +a

# Ansible login user created on the server + its password hash
# (generate a hash with: mkpasswd --method=sha-512  or  openssl passwd -6)
export ANSIBLE_USERNAME='deploy'
export ANSIBLE_USER_PASSWORD_HASH=''

# SSH public key authorized for the ansible/deploy user (the Hetzner deploy key)
export APP_SERVER_PUBLIC_KEY='ssh-ed25519 AAAA... quryltai-hetzner-deploy'

# Tailscale auth key to join the tailnet non-interactively
# (create at https://login.tailscale.com/admin/settings/keys)
export TAILSCALE_AUTH_KEY=''

# --- postgresql.yml ---
# Postgres superuser password and the application user's password
export PG_ROOT_USER_PASSWORD=''
export PG_APP_USER_PASSWORD=''

# --- redis.yml (localhost cache for future rate limiting) ---
export REDIS_PASSWORD=''

# --- hetzner-firewall.yml (edge firewall: 443 from Cloudflare only) ---
# Hetzner Cloud API token (read/write) and the ID of the firewall attached to
# the server. Create both in the Hetzner Cloud console.
export HETZNER_API_TOKEN=''
export HETZNER_FIREWALL_ID=''

# --- nginx.yml (Cloudflare origin over HTTPS) ---
# Domain Cloudflare points at this server
export DOMAIN=''
# Paths (on your machine) to the Cloudflare Origin CA cert + key
export CF_SSL_CERT_FILE=''
export CF_SSL_KEY_FILE=''
